# Vite dev server settings for local development.
# Copy to .env.local and adjust when running the React dev server against
# a backend on a non-default port.

# React dev server port (default: 5173)
VITE_DEV_PORT=5173

# Backend API origin for Vite proxy targets.
# For side-by-side local development, the repo-root dev config uses 8500.
VITE_API_ORIGIN=http://localhost:8500

# Optional explicit WebSocket origin. If omitted, derived from VITE_API_ORIGIN.
# VITE_WS_ORIGIN=ws://localhost:8500
