# Ignore ALL index backups
index_backups/

# Privacy-sensitive local config (never check in)
private/
# config.yaml.template is generated at build time (copied from the platform-
# specific checked-in template) and must not be committed at the repo root
config.yaml.template
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
*.DS_Store
/.idea/
/.vscode/
/index/*.index
/index/*.bin
/index/*.json
/index/*.sqlite
/logs/*
/data/thumbnails/*


# Qdrant data files
qdrant/
# Build and packaging
*.egg-info/
__pycache__/
*.pyc

# Index artifacts
index/*.faiss
index/*.faiss.*
index/*.ids
index/*.npy
index/*.sqlite*
data/
logs/

# Jupyter
*.ipynb
!internal/notebooks/*.ipynb
.ipynb_checkpoints/

# Virtual environment
.venv/
# media samples (ignore big videos)
data/sample_photos/*.MOV

# Ignore Windows ADS
*Zone.Identifier*
.ipynb_checkpoints/requirements-checkpoint.txt

# YOLOv8 model files (auto-downloaded by ultralytics)
yolov8*.pt
/models/

# React UI build artifacts
src/msa_apps/ui/dist/
src/msa_apps/ui/node_modules/
tests/e2e/node_modules/
tests/e2e/playwright-report/
tests/e2e/playwright-test-results/
tests/e2e/playwright-results.json
tests/e2e/playwright-junit.xml

