dist/
build/
installer/windows/assets/app.tar.gz
installer/windows-native/assets/app.zip
installer/windows-native/assets/ui-dist.zip
installer/windows-native/assets/uv.exe

installer/windows-native/tray/bin/
installer/windows-native/tray/obj/


# macOS installer: downloaded static binaries (fetched by build.sh at build time)
installer/macos/bin/
installer/macos/bin-x86_64/
installer/macos/lib/
