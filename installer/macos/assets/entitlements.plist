<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Hardened runtime is required for notarization. -->

    <!-- Allow loading unsigned dylibs from the pip-installed venv
         (insightface, onnxruntime, faiss native extensions etc. are not
         Apple-signed and would otherwise be blocked at load time). -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- The launcher opens localhost:8000 in the default browser. -->
    <key>com.apple.security.network.client</key>
    <true/>
</dict>
</plist>
