#!/usr/bin/env bash
# Media Search Agent — .pkg preinstall script
# Runs as root before files are copied.
#
# Checks:
#   1. macOS 12.0+ (Monterey)
#   2. Xcode Command Line Tools installed (required for InsightFace compilation)
#
# On failure: exits 1 which causes the installer to abort with an error dialog.

set -euo pipefail

# ── Logging ───────────────────────────────────────────────────────────────────
# $HOME is /var/root when running as root inside the installer framework.
# Use /Users/Shared so the log is accessible to the console user too.

LOG_DIR="/Users/Shared/MediaSearchAgent/Logs"
mkdir -p "$LOG_DIR"
LOG_FILE="$LOG_DIR/install-$(date +%Y%m%d-%H%M%S).log"
exec > >(tee -a "$LOG_FILE") 2>&1

log()  { echo "[$(date '+%H:%M:%S')] $*"; }
fail() { log "ERROR: $*"; exit 1; }

log "MediaSearchAgent preinstall starting"
log "macOS: $(sw_vers -productVersion)  arch: $(uname -m)"

# ── 1. macOS version ──────────────────────────────────────────────────────────

MACOS_MAJOR=$(sw_vers -productVersion | cut -d. -f1)
if [[ "$MACOS_MAJOR" -lt 12 ]]; then
  fail "macOS 12 (Monterey) or later is required. Found: $(sw_vers -productVersion)"
fi
log "macOS version OK: $(sw_vers -productVersion)"

# ── 2. Xcode Command Line Tools ───────────────────────────────────────────────
# InsightFace compiles C extensions during pip install; Xcode CLT is required.
# The installer cannot trigger the interactive CLT dialog, so we must check here
# and abort with a clear message if it's absent.

if ! xcode-select -p &>/dev/null; then
  # Trigger the CLT install dialog so the user knows what to do, then fail.
  xcode-select --install 2>/dev/null || true
  fail "Xcode Command Line Tools are not installed.

A dialog has been launched to install them. Please:
  1. Click 'Install' in the dialog and wait for it to complete.
  2. Re-run the MediaSearchAgent installer.

If no dialog appeared, run in Terminal: xcode-select --install"
fi
log "Xcode CLT: $(xcode-select -p)"

log "preinstall complete — proceeding with file installation"
exit 0
