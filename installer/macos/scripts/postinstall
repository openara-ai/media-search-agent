#!/usr/bin/env bash
# Media Search Agent — .pkg postinstall script
# Runs as root after files are copied into place.
#
# Responsibilities:
#   1. Determine install location ($INSTALL_LOCATION set by installer framework)
#   2. Copy the correct arch binaries (ARM64 or Intel) from payload to $MSA_ROOT/bin/
#   3. Run setup.sh as the logged-in user (not root) so venv and config land in
#      the user's home directory
#   4. On failure: open the install log in the default text editor

set -euo pipefail

# ── Paths ─────────────────────────────────────────────────────────────────────

# $INSTALL_LOCATION is set by the macOS installer framework (e.g. /Applications)
INSTALL_LOCATION="${INSTALL_LOCATION:-/Applications}"
# Per Phase 2F: APP_DIR = .app/Contents/Resources/ — all app code lives inside the bundle.
MSA_ROOT="$INSTALL_LOCATION/MediaSearchAgent.app/Contents/Resources"

# $HOME is /var/root when running as root inside the installer framework.
# Use /Users/Shared so the log is accessible to the console user too.
LOG_DIR="/Users/Shared/MediaSearchAgent/Logs"
mkdir -p "$LOG_DIR"
LOG_FILE="$LOG_DIR/install-$(date +%Y%m%d-%H%M%S).log"
exec > >(tee -a "$LOG_FILE") 2>&1

log()  { echo "[$(date '+%H:%M:%S')] $*"; }
fail() {
  log "ERROR: $*"
  # Open the log in the console user's GUI session (not as root)
  if [[ -n "${CONSOLE_UID:-}" ]]; then
    launchctl asuser "$CONSOLE_UID" open -t "$LOG_FILE" 2>/dev/null || true
  fi
  exit 1
}

log "MediaSearchAgent postinstall starting"
log "Install location: $MSA_ROOT"

# ── Determine logged-in user ──────────────────────────────────────────────────
# The installer runs as root; setup.sh must run as the console user so that
# Python packages, the venv, and config land in the user's home directory.

CONSOLE_USER=$(stat -f "%Su" /dev/console 2>/dev/null || echo "")
if [[ -z "$CONSOLE_USER" || "$CONSOLE_USER" == "root" ]]; then
  fail "Could not determine the logged-in user. Please re-run the installer while logged in."
fi
CONSOLE_UID=$(id -u "$CONSOLE_USER")
log "Running setup as user: $CONSOLE_USER (uid $CONSOLE_UID)"

# ── Copy arch-appropriate binaries ───────────────────────────────────────────

ARCH=$(uname -m)   # arm64 or x86_64
BIN_SRC="$MSA_ROOT/installer/macos/bin"
if [[ "$ARCH" == "x86_64" ]]; then
  BIN_SRC="$MSA_ROOT/installer/macos/bin-x86_64"
fi
BIN_DEST="$MSA_ROOT/bin"

log "Installing $ARCH binaries from $BIN_SRC → $BIN_DEST"
mkdir -p "$BIN_DEST"
if [[ -d "$BIN_SRC" ]] && [[ -n "$(ls -A "$BIN_SRC" 2>/dev/null)" ]]; then
  cp -f "$BIN_SRC"/. "$BIN_DEST"/ 2>/dev/null || cp -rf "$BIN_SRC"/. "$BIN_DEST"/
  chmod +x "$BIN_DEST"/exiftool "$BIN_DEST"/mediainfo "$BIN_DEST"/uv 2>/dev/null || true
  log "Binaries installed: $(ls "$BIN_DEST")"
else
  log "WARNING: No binaries found in $BIN_SRC — exiftool/mediainfo will fall back to PATH"
fi

# libmediainfo.dylib is embedded in Contents/Resources/lib/ at build time —
# no copy required. Verify it is present and warn if missing.
LIB_PATH="$MSA_ROOT/lib/libmediainfo.dylib"
if [[ -f "$LIB_PATH" ]]; then
  log "libmediainfo.dylib present at $LIB_PATH"
else
  log "WARNING: libmediainfo.dylib not found at $LIB_PATH — pymediainfo may fail"
fi

# ── Run setup.sh as the logged-in user ───────────────────────────────────────

SETUP_SH="$MSA_ROOT/scripts/setup.sh"
if [[ ! -f "$SETUP_SH" ]]; then
  fail "setup.sh not found at $SETUP_SH"
fi

log "Running setup.sh as $CONSOLE_USER..."
# --skip-models: model weights are downloaded on first launch via the in-app
# setup screen, giving the user real progress feedback instead of a silent wait
# inside the installer's "Running package scripts…" spinner.
launchctl asuser "$CONSOLE_UID" sudo -u "$CONSOLE_USER" \
  bash "$SETUP_SH" --non-interactive --skip-models \
  || fail "setup.sh failed. See log: $LOG_FILE"

log "postinstall complete"
exit 0
