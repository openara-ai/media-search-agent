# Pinned tool/runtime versions — single source of truth for all scripts.
# Shell scripts: source this file directly.
# Python scripts: parse key=value lines (see scripts/check_env.py).
#
# Platform-specific installer binary versions (UV_VERSION_WINDOWS_NATIVE, etc.)
# live in their respective installer scripts and are not shared here.

EXIFTOOL_VERSION=13.55
UV_VERSION=0.5.21
PYTHON_VERSION=3.12.8
NODE_MAJOR=20
DOTNET_SDK_MAJOR=8

# mediainfo CLI — platform-specific release channels (used by the desktop backend
# staging wrapper, scripts/stage-desktop-backend.sh; M-7). Matches the versions the
# legacy shell-bundle builder ships.
MEDIAINFO_VERSION_MACOS=24.01
MEDIAINFO_VERSION_LINUX=25.04
